#!/usr/bin/bash

set -eoux pipefail

# Keep Fedora's Mangohud and Bazzite's COPR KWin out of the image. This fork
# uses Terra's Mangohud and the Fedora KWin matching the installed Plasma.
dnf5 -y config-manager setopt \
    "fedora*.exclude=mesa-* kernel-core-* kernel-modules-* kernel-uki-virt-* steam noopenh264 mangohud" \
    "updates*.exclude=noopenh264 mangohud" \
    "*bazzite*.exclude=mangohud kwin*"
