#!/usr/bin/bash

set -eoux pipefail

echo "::group::Executing install-system76"
trap 'echo "::endgroup::"' EXIT

dnf5 -y copr enable szydell/system76

# Install the System76 Driver first, as required by the Fedora instructions.
if ! rpm -q system76-driver >/dev/null 2>&1; then
    dnf5 -y install system76-driver
fi

dnf5 -y install \
    firmware-manager \
    system76-firmware \
    system76-power

systemctl enable \
    system76-firmware-daemon.service \
    com.system76.PowerDaemon.service \
    system76-power-wake
# System76 Power provides the power-profile D-Bus interfaces itself. Disable
# both Fedora's TuneD compatibility service and TuneD, which can otherwise
# claim those interfaces or reapply competing power settings.
systemctl mask \
    power-profiles-daemon.service \
    tuned-ppd.service \
    tuned.service

dnf5 -y copr disable szydell/system76
